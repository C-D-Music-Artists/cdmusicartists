*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{

font-family:Arial,Helvetica,sans-serif;

background:#111;

color:white;

line-height:1.6;

}

header{

background:#000;

padding:20px 40px;

position:fixed;

width:100%;

top:0;

z-index:1000;

}

nav{

display:flex;

justify-content:space-between;

align-items:center;

}

.logo{

font-size:28px;

font-weight:bold;

color:#ff2d2d;

}

nav ul{

display:flex;

list-style:none;

gap:30px;

}

nav a{

text-decoration:none;

color:white;

transition:.3s;

}

nav a:hover{

color:#ff2d2d;

}

.hero{

height:100vh;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

text-align:center;

background:linear-gradient(#111,#000);

}

.hero h1{

font-size:70px;

margin-bottom:20px;

}

.hero h2{

font-size:32px;

margin-bottom:30px;

color:#ff2d2d;

}

.hero p{

font-size:22px;

margin-bottom:40px;

}

.button{

padding:18px 45px;

background:#ff2d2d;

color:white;

text-decoration:none;

border-radius:40px;

transition:.3s;

}

.button:hover{

background:white;

color:black;

}

section{

padding:100px 10%;

}

.about{

text-align:center;

}

.music{

text-align:center;

}

.cards{

display:flex;

justify-content:center;

gap:30px;

margin-top:50px;

flex-wrap:wrap;

}

.card{

width:300px;

height:180px;

background:#222;

display:flex;

justify-content:center;

align-items:center;

border-radius:20px;

transition:.3s;

}

.card:hover{

transform:translateY(-10px);

background:#ff2d2d;

}

footer{

padding:40px;

background:#000;

text-align:center;

}
